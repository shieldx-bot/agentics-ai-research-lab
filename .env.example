# ==== Agentics AI Research Lab — environment template ====
# Copy to .env and fill in. NEVER commit .env.

# GitHub personal access token with `repo` scope (create: https://github.com/settings/tokens)
GITHUB_TOKEN=
# Target repository the agents work on
GITHUB_REPO=shieldx-bot/agentics-ai-research-lab

# Max concurrent agent threads (= number of cookie files used)
MAX_AGENTS=10
# Pause between research cycles per agent (seconds)
CYCLE_PAUSE_SECONDS=60
# Auto-merge PRs after cross-review approval (true = full auto)
AUTO_MERGE=true

# Research domain injected into every agent prompt
RESEARCH_TOPIC=AI/ML for Network Function Virtualization (NFV) and 5G core automation

# Rootless Docker sandbox (required for untrusted agent code)
SANDBOX_ENABLED=true
SANDBOX_IMAGE=agentics-sandbox:py311
SANDBOX_REQUIRE_ROOTLESS=true
SANDBOX_CPU_MILLIS=1000
SANDBOX_MEMORY_MB=1024
SANDBOX_PIDS_LIMIT=128
SANDBOX_TMPFS_MB=128
