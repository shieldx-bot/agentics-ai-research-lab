# ==== Agentics AI Research Lab — environment template ====
# Copy to .env and fill in. NEVER commit .env.

# ==== Execution mode: LOCAL-ONLY (no GitHub) ====
# The lab runs entirely on this machine. "origin" for agent work is the bare
# repo seeded at data/lab.git — tasks, MRs, reviews and merges are local.
# GITHUB_TOKEN is NOT required anymore (legacy github_ops modules stay dormant).
# Owner visibility: python -m agentics.cli dashboard  (default port 8080)
DASHBOARD_PORT=8080
# P10 protected paths — lab code agents must never modify (comma separated).
# Owner per-task exception: python -m agentics.cli allow-protected <task_id>
# Run-wide emergency switch (still blocks accounts/ + secrets):
# ALLOW_PROTECTED_PATHS=1
PROTECTED_PATHS=agentics/,configs/,accounts/,scripts/,.github/

# Max concurrent agent threads (= number of cookie files used)
MAX_AGENTS=10
# Pause between research cycles per agent (seconds)
CYCLE_PAUSE_SECONDS=60
# Auto-merge is opt-in; keep false until CI, branch protection and review gates are verified
AUTO_MERGE=false

# ==== LLM backend ====
# "perplexity" = cookie socket.io, built-in web search + citations (accounts/account-*.json)
# "qwen"       = chat.qwen.ai native web API (accounts/qwen-*.json) — see docs/LLM_PROVIDERS.md
LLM_PROVIDER=perplexity
# Only used when LLM_PROVIDER=qwen. Available ids: qwen3.7-plus, qwen3.8-max, qwen4.0-max-preview
QWEN_MODEL=qwen4.0-max-preview

# Research domain injected into every agent prompt
RESEARCH_TOPIC=AI/ML for Network Function Virtualization (NFV) and 5G core automation

# ==== Browser backend (see docs/LLM_PROVIDERS.md) ====
# "local" (default) = raw cookie WebSocket from this machine (residential IP only)
# "hyperbrowser" = Perplexity sessions run on a Hyperbrowser cloud browser
BROWSER_BACKEND=local
# Hyperbrowser API key (https://app.hyperbrowser.ai/overview) — only for BROWSER_BACKEND=hyperbrowser.
# Can also live in configs/secrets.yaml as hyperbrowser_api_key (preferred, gitignored).
HB_API_KEY=
HB_PROXY_COUNTRY=US
HB_TIMEOUT=900
