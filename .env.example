# ==== Agentics AI Research Lab — environment template ====
# Copy to .env and fill in. NEVER commit .env.

# ==== Execution mode: LOCAL-ONLY (no GitHub) ====
# The lab runs entirely on this machine. "origin" for agent work is the bare
# repo seeded at data/lab.git — tasks, MRs, reviews and merges are local.
# GITHUB_TOKEN is NOT required anymore (legacy github_ops modules stay dormant).
# Owner visibility: python -m agentics.cli dashboard  (default port 8080)
DASHBOARD_PORT=8080
# P10 protected paths — lab code agents must never modify (comma separated).
# Owner per-task exception: python -m agentics.cli allow-protected <task_id>
# Run-wide emergency switch (still blocks accounts/ + secrets):
# ALLOW_PROTECTED_PATHS=1
PROTECTED_PATHS=agentics/,configs/,accounts/,scripts/,.github/
# P14 whitelist ring — files OUTSIDE these roots are refused for every agent
# (comma separated; leave empty to disable; union of ownership surfaces).
WRITABLE_ROOTS=research_notes/,experiments/,benchmarks/,tests/,docs/,reports/,README.md
# P13 — plan-time file locks TTL (minutes); dead agents' locks expire alone
FILE_LOCK_TTL_MINUTES=30
# P10 layer 4 — integrity self-healing sweep interval in seconds (0 = off)
INTEGRITY_INTERVAL_S=20

# Max concurrent agent threads (= number of cookie files used)
MAX_AGENTS=10
# Pause between research cycles per agent (seconds)
CYCLE_PAUSE_SECONDS=60
# Auto-merge is opt-in; keep false until CI, branch protection and review gates are verified
AUTO_MERGE=false
# Supervisor backlog watermark: keep at least this many unclaimed tasks in
# the local backlog so free coders/writers never idle behind an empty queue
# (topped up per scan from failure traces + survey rotation; 0 disables)
BACKLOG_WATERMARK=2

# ==== LLM backend ====
# "perplexity" = cookie socket.io, built-in web search + citations (accounts/account-*.json)
# "qwen"       = chat.qwen.ai native web API (accounts/qwen-*.json) — see docs/LLM_PROVIDERS.md
LLM_PROVIDER=perplexity
# Only used when LLM_PROVIDER=qwen. Available ids: qwen3.7-plus, qwen3.8-max, qwen4.0-max-preview
QWEN_MODEL=qwen4.0-max-preview

# Research domain injected into every agent prompt
RESEARCH_TOPIC=AI/ML for Network Function Virtualization (NFV) and 5G core automation

# ==== Browser backend (see docs/LLM_PROVIDERS.md) ====
# "local" (default) = raw cookie WebSocket from this machine (residential IP only)
# "hyperbrowser" = Perplexity sessions run on a Hyperbrowser cloud browser
BROWSER_BACKEND=local
# Hyperbrowser API key (https://app.hyperbrowser.ai/overview) — only for BROWSER_BACKEND=hyperbrowser.
# Can also live in configs/secrets.yaml as hyperbrowser_api_key (preferred, gitignored).
HB_API_KEY=
HB_PROXY_COUNTRY=US
HB_TIMEOUT=900

# ==== GitHub API safety (rate limits / 5xx incidents) ====
# Min interval between GitHub API calls process-wide (all agent threads share
# one PAT). 1.0s ≈ 3600 req/h — safely under the 5000 req/h core limit.
GH_MIN_API_INTERVAL=1.0
# TTL (s) for the shared open-issue scan cache: concurrent agent scans within
# the window cost ONE API call instead of N.
GH_SCAN_CACHE_TTL=60

# ==== Hyperbrowser cloud browser ====
# How long to wait for the Perplexity input box before failing an ask with a
# diagnostic error (challenge page / logged-out wall / UI markup change).
HB_INPUT_TIMEOUT=45

# ==== Free keyless research tools (docs/FREE_TOOLS.md) ====
# Official publisher APIs (arXiv / OpenAlex / Crossref / Semantic Scholar /
# Europe PMC / GitHub / PyPI / HuggingFace / Wikipedia / DuckDuckGo) — real
# metadata, no account or token. They ground findings in verifiable
# citations, keep node_research alive when every LLM cookie is dead, and the
# verification toolkit (GitHub repos / PyPI pins / HF datasets+models) gives
# protocols real code + data + dependency versions. 0 = disable (LLM-only
# behaviour restored).
FREE_TOOLS_ENABLED=1
# Per-call HTTP timeout in seconds
FREE_TOOLS_TIMEOUT=15
# Optional polite-pool contact for OpenAlex/Crossref (a plain email you own).
# Not required, but puts the calls in the friendlier rate-limit tier.
FREE_TOOLS_MAILTO=

# ==== P19 peer panel (đánh giá lẫn nhau) ====
# How many cross-reviewers must unanimously accept before an MR passes.
# Raise it to involve the whole swarm (every alive non-author agent).
PEER_PANEL_SIZE=2
# Minutes the author has to defend EVERY objection once one reject vote
# opens the defense round. Missing/incomplete defense = the MR is rejected
# for good and the task returns to the open pool.
PEER_DEFENSE_TTL_MINUTES=30

# ==== P23 replay (tự kiểm chứng lại knowledge đã settled) ====
# How many settled claims one supervisor sweep replays from their stored
# protocol source (0 = off). Every outcome lands in shared evidence
# (method='replay') — drift (supported->refuted) auto-corrects
# verified_knowledge for the whole swarm. Owner one-shot: agentics replay.
REPLAY_SWEEP_SIZE=2
# Run the replay sweep every N supervisor cycles.
REPLAY_EVERY_N_CYCLES=3
# P24bis — independent replication: a REVIEWER re-runs settled claims from
# their stored protocols in its OWN workspace (never the author's). How many
# claims one reviewer cycle replicates (0 = off). No LLM involved; a refuted
# replication re-verdicts the author's evidence and downgrades the claim,
# an inconclusive one never refutes. Detail lands in the replications table.
REPLICATION_LIMIT=1

# ---- QD ideation closed loop (IDEAgent gate + Kosmos harvest) ------------
# After a deep-dive settle the experiment proposes 0-2 FOLLOW-UP hypotheses
# (children, gated: near-dup gate + judge scores + one repair round), and
# when the topic + registry are both exhausted the world model proposes ONE
# gap-closing hypothesis instead of idling. Every settle lands in the
# experiment ledger; inconclusive protocols get bounded retries.
# 0 = turn the whole loop off (no ideation LLM calls).
AGENTICS_IDEATION=1
# IDEAgent qualification gate: accept a proposed idea at tau (0-100) across
# non-obviousness / soundness / clarity; near-misses within the repair
# margin get exactly ONE repair round; weaker ideas are archived as compact
# rejected patterns that future ideation prompts avoid.
IDEA_MIN_SCORE=60
IDEA_REPAIR_MARGIN=20
# How many follow-up hypotheses one settled experiment may spawn.
IDEA_MAX_CHILDREN=2
# How many times an inconclusive deep-dive protocol is retried before the
# claim is retired (autoresearch: fix it, then move on).
IDEA_MAX_ATTEMPTS=2

# Settle anchor law (verdict provenance): a verdict is recorded `supported`
# ONLY when at least one deciding input lies outside the agent's reach
# (external citation URL / independent replication / owner approval via
# `python -m agentics.cli approve <id>` / pinned-hash dataset). Anchorless
# supported verdicts are downgraded to `unanchored` and wait for
# replication. Set 0 to restore the legacy single-actor behavior.
SETTLE_REQUIRE_ANCHOR=1
# Discovery double-judge gate: mark_discovery fires only when a SECOND
# account (an identity other than the author's) also grades the result
# surprising AND its answer carries at least one external citation URL.
# Single-account setups never mark discoveries while this is 1.
DISCOVERY_SECOND_JUDGE=1

# --- Wave-3 advanced add-ons -----------------------------------------------
# GEPA-style reflective prompt regeneration: when a role mission keeps
# failing, the local model first critiques it against the real failure
# traces, then rewrites it against that critique (generator only — the
# lab's exit-code feedback stays the judge). 0 = plain mutation only.
GEPA_REFLECTION=1
# Static cascade (roadmap #2): when a pool-side ask fails (dry pool /
# provider error), allowed purposes get ONE retry against the frontier
# provider below. Verdict/jury purposes can NEVER cascade. "" = off.
LLM_CASCADE_PROVIDER=
LLM_CASCADE_PURPOSES=research,plan,implement
# MCP bridge (roadmap #3): OWNER-APPROVED stdio servers as a JSON map,
# e.g. {"arxiv": "python -m mcp_server_arxiv"}. Empty = strict no-op.
MCP_SERVERS=
MCP_TIMEOUT_S=30
# Learned risk gate (roadmap #5): shadow-only v1 — journals the learned
# P(settle clean) before each panel opens; never blocks. off|shadow|soft.
RISK_GATE_MODE=shadow
RISK_GATE_SOFT_THRESHOLD=0.25
